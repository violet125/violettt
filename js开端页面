<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>江南水乡 · 3D立体水乡</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0d1114;
    overflow: hidden;
    font-family: 'Inter', 'Noto Serif SC', serif;
  }
  #scene {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    display: block;
  }
  .plaque-hotspot {
    position: fixed;
    z-index: 20;
    cursor: pointer;
    border-radius: 4px;
    transition: all 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 245, 220, 0);
    font-size: 0.95rem;
    letter-spacing: 4px;
    font-weight: 500;
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.9);
    user-select: none;
    pointer-events: auto;
    border: 1px solid rgba(255, 255, 255, 0);
    background: transparent;
  }
  .plaque-hotspot:hover {
    background: rgba(255, 235, 190, 0.15);
    box-shadow: 0 0 35px rgba(255, 210, 140, 0.3), inset 0 0 25px rgba(255, 220, 160, 0.08);
    border-color: rgba(255, 225, 170, 0.6);
    color: rgba(255, 248, 230, 1);
    transform: scale(1.04);
  }
  .plaque-hotspot:active {
    transform: scale(0.97);
    transition: transform 0.06s ease;
  }
  .transition-mask {
    position: fixed;
    inset: 0;
    background: #0a0e12;
    z-index: 200;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.75s ease;
  }
  .transition-mask.active { opacity: 1; }
  .tip {
    position: fixed;
    bottom: 4%;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(220, 230, 240, 0.5);
    font-size: 0.8rem;
    letter-spacing: 8px;
    z-index: 30;
    pointer-events: none;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.9);
    animation: tipBreath 5s ease-in-out infinite;
    white-space: nowrap;
  }
  @keyframes tipBreath {
    0%, 100% { opacity: 0.35; letter-spacing: 8px; }
    50% { opacity: 0.75; letter-spacing: 10px; }
  }
  @media (max-width: 700px) {
    .plaque-hotspot { font-size: 0.65rem; letter-spacing: 2px; }
    .tip { font-size: 0.6rem; letter-spacing: 4px; }
  }
</style>
</head>
<body>
<canvas id="scene"></canvas>
<div class="transition-mask" id="transitionMask"></div>
<div class="tip">四 坊 通 幽</div>

<script>
(function() {
  const canvas = document.getElementById('scene');
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0;

  // 牌匾定义
  const plaques = [
    { label: '烟雨坊', x: 0, y: 0, w: 0, h: 0, target: 'https://www.example.com/1' },
    { label: '柳浪坊', x: 0, y: 0, w: 0, h: 0, target: 'https://www.example.com/2' },
    { label: '荷风坊', x: 0, y: 0, w: 0, h: 0, target: 'https://www.example.com/3' },
    { label: '听雨坊', x: 0, y: 0, w: 0, h: 0, target: 'https://www.example.com/4' }
  ];
  let plaqueElements = [];
  let time = 0;
  let waterOffset = 0;

  // 数据容器
  let houses = [];
  let willows = [];
  let plants = [];

  // ---------- 初始化 ----------
  function resize() {
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W;
    canvas.height = H;
    buildScene();
    buildPlaques();
  }

  // ---------- 构建场景数据 ----------
  function buildScene() {
    // 房屋：左右两岸，分5个纵深层次，每层数量递减
    houses = [];
    const layers = [
      { depth: 0, scale: 0.5, yBase: 0.42, count: 5, alpha: 0.55 },
      { depth: 1, scale: 0.68, yBase: 0.46, count: 4, alpha: 0.72 },
      { depth: 2, scale: 0.88, yBase: 0.50, count: 3, alpha: 0.88 },
      { depth: 3, scale: 1.10, yBase: 0.55, count: 3, alpha: 1.0 },
      { depth: 4, scale: 1.35, yBase: 0.61, count: 2, alpha: 1.0 }
    ];

    layers.forEach(layer => {
      ['left', 'right'].forEach(side => {
        for (let i = 0; i < layer.count; i++) {
          const t = layer.count > 1 ? i / (layer.count - 1) : 0.5;
          const isLeft = side === 'left';
          // 沿河岸排列：左侧 x 从 0.02 到 0.32，右侧从 0.98 到 0.68
          const baseX = isLeft
            ? W * (0.02 + t * 0.30)
            : W * (0.98 - t * 0.30);
          const yPos = H * layer.yBase + t * H * 0.03;
          const w = W * (0.10 + Math.random() * 0.05) * layer.scale;
          const h = H * (0.16 + Math.random() * 0.07) * layer.scale;

          houses.push({
            x: baseX,
            y: yPos,
            w: w,
            h: h,
            scale: layer.scale,
            alpha: layer.alpha,
            depth: layer.depth,
            facing: isLeft ? 1 : -1,
            side: side,
            roofHue: 200 + Math.random() * 15,
            wallTone: 0.88 + Math.random() * 0.12
          });
        }
      });
    });
    // 按深度排序（远到近）
    houses.sort((a, b) => a.depth - b.depth);

    // 柳枝
    willows = [];
    for (let side of ['left', 'right']) {
      for (let i = 0; i < 5; i++) {
        willows.push({
          side: side,
          x: side === 'left' ? W * (0.01 + i * 0.06) : W * (0.99 - i * 0.06),
          y: H * (0.38 + Math.random() * 0.08),
          len: H * (0.16 + Math.random() * 0.12),
          phase: Math.random() * Math.PI * 2,
          speed: 0.008 + Math.random() * 0.008,
          amp: 0.035 + Math.random() * 0.035,
          hue: 100 + Math.random() * 30,
          leaves: 4 + Math.floor(Math.random() * 5)
        });
      }
    }

    // 花草
    plants = [];
    for (let i = 0; i < 14; i++) {
      const side = Math.random() > 0.5 ? 'left' : 'right';
      plants.push({
        x: side === 'left' ? W * (0.03 + Math.random() * 0.22) : W * (0.75 + Math.random() * 0.22),
        y: H * (0.58 + Math.random() * 0.18),
        size: 8 + Math.random() * 12,
        phase: Math.random() * Math.PI * 2,
        speed: 0.01 + Math.random() * 0.012,
        amp: 0.06 + Math.random() * 0.06,
        color: `hsl(${90 + Math.random() * 60}, 45%, ${45 + Math.random() * 25}%)`,
        flower: Math.random() > 0.6,
        flowerColor: `hsl(${330 + Math.random() * 40}, 70%, 70%)`
      });
    }
  }

  // ---------- 构建牌匾 DOM 热区 ----------
  function buildPlaques() {
    plaqueElements.forEach(el => el.remove());
    plaqueElements = [];

    // 牌匾位置：固定分布在左右两岸
    const pw = Math.min(W * 0.13, 140);
    const ph = pw * 0.38;

    // 左上、右上、左下、右下
    plaques[0].x = W * 0.12; plaques[0].y = H * 0.30;
    plaques[1].x = W * 0.75; plaques[1].y = H * 0.28;
    plaques[2].x = W * 0.09; plaques[2].y = H * 0.52;
    plaques[3].x = W * 0.78; plaques[3].y = H * 0.50;
    plaques.forEach(p => { p.w = pw; p.h = ph; });

    plaques.forEach(p => {
      const el = document.createElement('div');
      el.className = 'plaque-hotspot';
      el.textContent = p.label;
      el.style.left = p.x + 'px';
      el.style.top = p.y + 'px';
      el.style.width = p.w + 'px';
      el.style.height = p.h + 'px';
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        triggerTransition(p.target);
      });
      document.body.appendChild(el);
      plaqueElements.push(el);
    });
  }

  // ---------- 跳转 ----------
  let isTransitioning = false;
  function triggerTransition(url) {
    if (isTransitioning) return;
    isTransitioning = true;
    document.getElementById('transitionMask').classList.add('active');
    setTimeout(() => { window.location.href = url; }, 750);
  }

  // ---------- 天空 ----------
  function drawSky() {
    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, '#c6d0da');
    grad.addColorStop(0.4, '#b8c4ce');
    grad.addColorStop(0.7, '#aab6c2');
    grad.addColorStop(1, '#9aa8b4');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // 远山
    ctx.beginPath();
    ctx.moveTo(0, H * 0.42);
    ctx.lineTo(W * 0.15, H * 0.30);
    ctx.lineTo(W * 0.30, H * 0.38);
    ctx.lineTo(W * 0.45, H * 0.26);
    ctx.lineTo(W * 0.60, H * 0.36);
    ctx.lineTo(W * 0.75, H * 0.28);
    ctx.lineTo(W * 0.90, H * 0.36);
    ctx.lineTo(W, H * 0.32);
    ctx.lineTo(W, H);
    ctx.lineTo(0, H);
    ctx.closePath();
    ctx.fillStyle = 'rgba(150, 168, 182, 0.30)';
    ctx.fill();

    // 远处雾气
    ctx.fillStyle = 'rgba(200, 212, 222, 0.18)';
    ctx.fillRect(0, H * 0.38, W, H * 0.10);
  }

  // ---------- 单栋3D房屋 ----------
  function drawHouse(h) {
    const { x, y, w, h: hh, scale, alpha, facing, depth, roofHue, wallTone } = h;
    const baseX = x;
    const baseY = y + hh;

    ctx.save();
    ctx.globalAlpha = alpha;

    // 立体侧面深度
    const sideD = w * 0.25 * scale;
    const sideOff = facing * sideD;

    // ---- 右侧暗面 ----
    ctx.fillStyle = `rgba(${Math.floor(110 * wallTone)}, ${Math.floor(105 * wallTone)}, ${Math.floor(98 * wallTone)}, 1)`;
    ctx.beginPath();
    ctx.moveTo(baseX + w / 2, baseY);
    ctx.lineTo(baseX + w / 2 + sideOff, baseY - sideD * 0.35);
    ctx.lineTo(baseX + w / 2 + sideOff, baseY - hh - sideD * 0.35);
    ctx.lineTo(baseX + w / 2, baseY - hh);
    ctx.closePath();
    ctx.fill();

    // 侧面暗部
    ctx.fillStyle = `rgba(${Math.floor(70 * wallTone)}, ${Math.floor(66 * wallTone)}, ${Math.floor(62 * wallTone)}, 0.65)`;
    ctx.beginPath();
    ctx.moveTo(baseX + w / 2, baseY);
    ctx.lineTo(baseX + w / 2 + sideOff, baseY - sideD * 0.35);
    ctx.lineTo(baseX + w / 2 + sideOff, baseY - hh - sideD * 0.35);
    ctx.lineTo(baseX + w / 2, baseY - hh);
    ctx.closePath();
    ctx.fill();

    // ---- 正面白墙 ----
    const wallGrad = ctx.createLinearGradient(baseX - w / 2, baseY - hh, baseX + w / 2, baseY);
    wallGrad.addColorStop(0, `rgba(${Math.floor(238 * wallTone)}, ${Math.floor(235 * wallTone)}, ${Math.floor(228 * wallTone)}, 1)`);
    wallGrad.addColorStop(0.7, `rgba(${Math.floor(222 * wallTone)}, ${Math.floor(219 * wallTone)}, ${Math.floor(212 * wallTone)}, 1)`);
    wallGrad.addColorStop(1, `rgba(${Math.floor(196 * wallTone)}, ${Math.floor(193 * wallTone)}, ${Math.floor(186 * wallTone)}, 1)`);
    ctx.fillStyle = wallGrad;
    ctx.fillRect(baseX - w / 2, baseY - hh, w, hh);

    // 砖缝
    ctx.strokeStyle = 'rgba(140, 138, 130, 0.18)';
    ctx.lineWidth = 0.8;
    for (let i = 1; i < 6; i++) {
      const ly = baseY - hh + (hh / 6) * i;
      ctx.beginPath();
      ctx.moveTo(baseX - w / 2, ly);
      ctx.lineTo(baseX + w / 2, ly);
      ctx.stroke();
    }

    // ---- 屋顶（立体黛瓦）----
    const roofH = hh * 0.24;
    const roofOver = w * 0.15;
    const roofDepth = sideD * 0.55;

    // 屋顶正面坡面
    const roofGrad = ctx.createLinearGradient(baseX - w / 2, baseY - hh, baseX + w / 2, baseY - hh - roofH);
    roofGrad.addColorStop(0, `hsl(${roofHue}, 20%, 26%)`);
    roofGrad.addColorStop(0.5, `hsl(${roofHue}, 22%, 34%)`);
    roofGrad.addColorStop(1, `hsl(${roofHue}, 24%, 42%)`);
    ctx.fillStyle = roofGrad;
    ctx.beginPath();
    ctx.moveTo(baseX - w / 2 - roofOver, baseY - hh);
    ctx.lineTo(baseX + w / 2 + roofOver, baseY - hh);
    ctx.lineTo(baseX + w / 2 + roofOver * 0.5, baseY - hh - roofH * 0.5);
    ctx.lineTo(baseX, baseY - hh - roofH);
    ctx.lineTo(baseX - w / 2 - roofOver * 0.5, baseY - hh - roofH * 0.5);
    ctx.closePath();
    ctx.fill();

    // 屋顶右侧立体面
    ctx.fillStyle = `hsl(${roofHue}, 18%, 16%)`;
    ctx.beginPath();
    ctx.moveTo(baseX + w / 2 + roofOver, baseY - hh);
    ctx.lineTo(baseX + w / 2 + roofOver + roofDepth, baseY - hh - roofDepth * 0.5);
    ctx.lineTo(baseX + w / 2 + roofOver * 0.5 + roofDepth, baseY - hh - roofH * 0.5 - roofDepth * 0.5);
    ctx.lineTo(baseX + w / 2 + roofOver * 0.5, baseY - hh - roofH * 0.5);
    ctx.closePath();
    ctx.fill();

    // 屋顶高光
    ctx.fillStyle = `hsla(${roofHue}, 30%, 58%, 0.30)`;
    ctx.beginPath();
    ctx.moveTo(baseX - w / 2 - roofOver * 0.3, baseY - hh - roofH * 0.08);
    ctx.lineTo(baseX + w / 2 + roofOver * 0.3, baseY - hh - roofH * 0.08);
    ctx.lineTo(baseX + w / 2 + roofOver * 0.2, baseY - hh - roofH * 0.28);
    ctx.lineTo(baseX, baseY - hh - roofH * 0.58);
    ctx.lineTo(baseX - w / 2 - roofOver * 0.2, baseY - hh - roofH * 0.28);
    ctx.closePath();
    ctx.fill();

    // 瓦楞线
    ctx.strokeStyle = `hsla(${roofHue}, 15%, 12%, 0.5)`;
    ctx.lineWidth = 1;
    for (let i = 1; i < 8; i++) {
      const t = i / 8;
      const x1 = baseX - w / 2 - roofOver + (w + roofOver * 2) * t;
      const y1 = baseY - hh - roofH * (1 - Math.abs(t - 0.5) * 1.5);
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x1 - (t < 0.5 ? 3 : -3), y1 - roofH * 0.5);
      ctx.stroke();
    }

    // ---- 窗户 ----
    const winW = w * 0.32;
    const winH = hh * 0.34;
    const winX = baseX - winW / 2 + facing * w * 0.06;
    const winY = baseY - hh + hh * 0.22;

    // 窗框
    ctx.fillStyle = '#1a120c';
    ctx.fillRect(winX - 3, winY - 3, winW + 6, winH + 6);
    // 窗芯
    ctx.fillStyle = '#4a3a2a';
    ctx.fillRect(winX, winY, winW, winH);
    // 窗格
    ctx.strokeStyle = '#8a7a62';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(winX + winW / 2, winY);
    ctx.lineTo(winX + winW / 2, winY + winH);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(winX, winY + winH / 2);
    ctx.lineTo(winX + winW, winY + winH / 2);
    ctx.stroke();
    ctx.strokeStyle = '#6a5a4a';
    ctx.lineWidth = 0.8;
    for (let i = 1; i < 4; i++) {
      ctx.beginPath();
      ctx.moveTo(winX + (winW / 4) * i, winY);
      ctx.lineTo(winX + (winW / 4) * i, winY + winH);
      ctx.stroke();
    }
    for (let i = 1; i < 3; i++) {
      ctx.beginPath();
      ctx.moveTo(winX, winY + (winH / 3) * i);
      ctx.lineTo(winX + winW, winY + (winH / 3) * i);
      ctx.stroke();
    }

    // ---- 门 ----
    const doorW = w * 0.22;
    const doorH = hh * 0.44;
    const doorX = baseX - doorW / 2 - facing * w * 0.10;
    const doorY = baseY - doorH;

    ctx.fillStyle = '#1a120c';
    ctx.fillRect(doorX - 2, doorY - 2, doorW + 4, doorH + 4);
    ctx.fillStyle = '#3a2a1a';
    ctx.fillRect(doorX, doorY, doorW, doorH);
    ctx.strokeStyle = '#5a4a3a';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(doorX + doorW / 2, doorY);
    ctx.lineTo(doorX + doorW / 2, doorY + doorH);
    ctx.stroke();
    // 门环
    ctx.beginPath();
    ctx.arc(doorX + doorW * 0.3, doorY + doorH * 0.42, 2.5, 0, Math.PI * 2);
    ctx.fillStyle = '#8a7a62';
    ctx.fill();
    ctx.beginPath();
    ctx.arc(doorX + doorW * 0.7, doorY + doorH * 0.42, 2.5, 0, Math.PI * 2);
    ctx.fill();

    // 灯笼（仅近处房屋）
    if (depth >= 3) {
      const lx = baseX + facing * w * 0.42;
      const ly = baseY - hh - roofH * 0.25;
      ctx.beginPath();
      ctx.ellipse(lx, ly, 6 * scale, 8 * scale, 0, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(210, 90, 55, 0.85)';
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse(lx, ly - 2, 6 * scale, 8 * scale, 0, Math.PI, Math.PI * 2);
      ctx.fillStyle = 'rgba(240, 140, 80, 0.7)';
      ctx.fill();
      ctx.beginPath();
      ctx.moveTo(lx, ly + 8 * scale);
      ctx.lineTo(lx, ly + 14 * scale);
      ctx.strokeStyle = '#a06040';
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    ctx.restore();
  }

  // ---------- 绘制所有房屋 ----------
  function drawAllHouses() {
    houses.forEach(h => drawHouse(h));
  }

  // ---------- 水面 ----------
  function drawWater() {
    const waterTop = H * 0.70;
    const waterH = H * 0.30;

    const waterGrad = ctx.createLinearGradient(0, waterTop, 0, H);
    waterGrad.addColorStop(0, '#3a5a6a');
    waterGrad.addColorStop(0.4, '#2e4a5a');
    waterGrad.addColorStop(1, '#1e2e3e');
    ctx.fillStyle = waterGrad;
    ctx.fillRect(0, waterTop, W, waterH);

    // 倒影（简化：反射房屋色块）
    ctx.save();
    ctx.globalAlpha = 0.10;
    ctx.scale(1, -0.55);
    ctx.translate(0, -waterTop * 2.8);
    houses.forEach(h => {
      ctx.fillStyle = 'rgba(220, 218, 210, 0.5)';
      ctx.fillRect(h.x - h.w / 2, h.y, h.w, h.h);
      ctx.fillStyle = 'rgba(40, 55, 70, 0.6)';
      ctx.fillRect(h.x - h.w / 2, h.y - h.h * 0.3, h.w, h.h * 0.3);
    });
    ctx.restore();

    // 水波纹
    for (let i = 0; i < 12; i++) {
      const yBase = waterTop + (waterH / 12) * i + 6;
      ctx.beginPath();
      ctx.moveTo(0, yBase);
      for (let x = 0; x <= W; x += 10) {
        const y = yBase
          + Math.sin(x * 0.011 + waterOffset + i * 1.3) * 2.5
          + Math.sin(x * 0.023 + waterOffset * 1.5 + i) * 1.2;
        ctx.lineTo(x, y);
      }
      ctx.strokeStyle = `rgba(160, 200, 220, ${0.10 + i * 0.008})`;
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    // 水面高光
    ctx.save();
    ctx.globalAlpha = 0.15;
    for (let i = 0; i < 15; i++) {
      const hx = (Math.sin(i * 2.3 + waterOffset * 0.4) * 0.5 + 0.5) * W;
      const hy = waterTop + 15 + (i * 31) % (waterH - 30);
      ctx.fillStyle = 'rgba(255, 240, 210, 0.6)';
      ctx.beginPath();
      ctx.ellipse(hx, hy, 15 + Math.sin(i) * 10, 1.2, 0, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  // ---------- 桥 ----------
  function drawBridge() {
    const waterTop = H * 0.70;
    const bridgeY = waterTop - 5;
    const bridgeW = W * 0.38;
    const bridgeH = H * 0.12;
    const bridgeX = W * 0.5 - bridgeW / 2;

    ctx.save();

    // 桥洞
    ctx.fillStyle = '#152230';
    ctx.beginPath();
    ctx.ellipse(W * 0.5, bridgeY + bridgeH * 0.55, bridgeW * 0.35, bridgeH * 0.65, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#2e4a5a';
    ctx.beginPath();
    ctx.ellipse(W * 0.5, bridgeY + bridgeH * 0.60, bridgeW * 0.32, bridgeH * 0.58, 0, 0, Math.PI * 2);
    ctx.fill();

    // 桥身
    ctx.shadowColor = 'rgba(0, 0, 0, 0.4)';
    ctx.shadowBlur = 22;
    ctx.shadowOffsetY = 8;
    const stoneGrad = ctx.createLinearGradient(bridgeX, bridgeY - bridgeH, bridgeX + bridgeW, bridgeY + bridgeH);
    stoneGrad.addColorStop(0, '#8a8a7a');
    stoneGrad.addColorStop(0.5, '#9c9c8c');
    stoneGrad.addColorStop(1, '#7a7a6a');
    ctx.fillStyle = stoneGrad;
    ctx.beginPath();
    ctx.moveTo(bridgeX, bridgeY + bridgeH);
    ctx.quadraticCurveTo(W * 0.5, bridgeY - bridgeH * 0.55, bridgeX + bridgeW, bridgeY + bridgeH);
    ctx.lineTo(bridgeX + bridgeW, bridgeY + bridgeH + 15);
    ctx.quadraticCurveTo(W * 0.5, bridgeY - bridgeH * 0.55 + 15, bridgeX, bridgeY + bridgeH + 15);
    ctx.closePath();
    ctx.fill();

    // 桥面
    ctx.shadowBlur = 8;
    ctx.fillStyle = '#b4b4a4';
    ctx.beginPath();
    ctx.moveTo(bridgeX + 8, bridgeY + bridgeH - 2);
    ctx.quadraticCurveTo(W * 0.5, bridgeY - bridgeH * 0.45, bridgeX + bridgeW - 8, bridgeY + bridgeH - 2);
    ctx.lineTo(bridgeX + bridgeW - 8, bridgeY + bridgeH + 6);
    ctx.quadraticCurveTo(W * 0.5, bridgeY - bridgeH * 0.45 + 8, bridgeX + 8, bridgeY + bridgeH + 6);
    ctx.closePath();
    ctx.fill();

    // 桥栏
    ctx.shadowColor = 'transparent';
    ctx.shadowBlur = 0;
    ctx.shadowOffsetY = 0;
    ctx.strokeStyle = '#6a6a5a';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(bridgeX + 12, bridgeY + bridgeH - 8);
    ctx.quadraticCurveTo(W * 0.5, bridgeY - bridgeH * 0.40 - 8, bridgeX + bridgeW - 12, bridgeY + bridgeH - 8);
    ctx.stroke();

    // 栏杆立柱
    ctx.fillStyle = '#5a5a4a';
    for (let i = 0; i <= 10; i++) {
      const t = i / 10;
      const px = bridgeX + 12 + (bridgeW - 24) * t;
      const py = bridgeY + bridgeH - 8 + Math.sin(t * Math.PI) * (-bridgeH * 0.9);
      ctx.fillRect(px - 2, py - 10, 4, 14);
    }

    // 桥面青石板
    ctx.strokeStyle = 'rgba(80, 80, 70, 0.35)';
    ctx.lineWidth = 1;
    for (let i = 1; i < 12; i++) {
      const t = i / 12;
      const px = bridgeX + 8 + (bridgeW - 16) * t;
      const py = bridgeY + bridgeH - 2 + Math.sin(t * Math.PI) * (-bridgeH * 0.85);
      ctx.beginPath();
      ctx.moveTo(px, py);
      ctx.lineTo(px, py - 6);
      ctx.stroke();
    }

    ctx.restore();
  }

  // ---------- 石阶 ----------
  function drawSteps() {
    const waterTop = H * 0.70;
    ctx.save();
    ctx.shadowColor = 'rgba(0, 0, 0, 0.25)';
    ctx.shadowBlur = 10;
    ctx.shadowOffsetY = 4;
    for (let i = 0; i < 5; i++) {
      ctx.fillStyle = `hsl(40, 10%, ${58 + i * 4}%)`;
      ctx.fillRect(W * 0.02 + i * 6, waterTop + i * 10, W * 0.12 - i * 5, 7);
      ctx.fillRect(W * 0.98 - W * 0.12 + i * 5, waterTop + i * 10, W * 0.12 - i * 5, 7);
    }
    ctx.restore();
  }

  // ---------- 柳枝 ----------
  function drawWillows() {
    willows.forEach(w => {
      const sway = Math.sin(time * w.speed + w.phase) * w.amp;
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(w.x, w.y);
      ctx.quadraticCurveTo(
        w.x + sway * 25,
        w.y + w.len * 0.35,
        w.x + sway * 50,
        w.y + w.len
      );
      ctx.strokeStyle = `hsla(${w.hue - 20}, 35%, 30%, 0.75)`;
      ctx.lineWidth = 2.5;
      ctx.stroke();

      for (let i = 0; i < w.leaves; i++) {
        const t = (i + 1) / (w.leaves + 1);
        const bx = w.x + sway * 50 * t;
        const by = w.y + w.len * t;
        const bSway = Math.sin(time * w.speed * 1.3 + w.phase + i * 0.8) * w.amp * 1.1;
        ctx.beginPath();
        ctx.moveTo(bx, by);
        ctx.quadraticCurveTo(
          bx + bSway * 20 + (w.side === 'left' ? 6 : -6),
          by + w.len * 0.25,
          bx + bSway * 35 + (w.side === 'left' ? 12 : -12),
          by + w.len * 0.5
        );
        ctx.strokeStyle = `hsla(${w.hue}, 45%, ${48 + i * 3}%, 0.6)`;
        ctx.lineWidth = 1.4;
        ctx.stroke();

        // 柳叶
        ctx.beginPath();
        ctx.ellipse(
          bx + bSway * 25 + (w.side === 'left' ? 9 : -9),
          by + w.len * 0.38,
          3.5, 1.8, bSway * 0.6, 0, Math.PI * 2
        );
        ctx.fillStyle = `hsla(${w.hue + 10}, 55%, ${52 + i * 2}%, 0.7)`;
        ctx.fill();
      }
      ctx.restore();
    });
  }

  // ---------- 花草 ----------
  function drawPlants() {
    plants.forEach(p => {
      const sway = Math.sin(time * p.speed + p.phase) * p.amp;
      const sway2 = Math.sin(time * p.speed * 1.7 + p.phase + 1) * p.amp * 0.7;
      ctx.save();

      // 花盆
      ctx.fillStyle = '#5a3a2a';
      ctx.shadowColor = 'rgba(0, 0, 0, 0.25)';
      ctx.shadowBlur = 8;
      ctx.shadowOffsetY = 3;
      ctx.beginPath();
      ctx.moveTo(p.x - p.size * 0.55, p.y);
      ctx.lineTo(p.x + p.size * 0.55, p.y);
      ctx.lineTo(p.x + p.size * 0.45, p.y + p.size * 0.55);
      ctx.lineTo(p.x - p.size * 0.45, p.y + p.size * 0.55);
      ctx.closePath();
      ctx.fill();

      ctx.shadowColor = 'transparent';
      ctx.shadowBlur = 0;
      ctx.shadowOffsetY = 0;

      // 茎叶
      for (let i = 0; i < 4; i++) {
        const angle = -Math.PI / 2 + (i - 1.5) * 0.38 + sway * 0.5;
        const len = p.size * (0.75 + Math.sin(i) * 0.3);
        const ex = p.x + Math.cos(angle) * len;
        const ey = p.y + Math.sin(angle) * len;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.quadraticCurveTo(
          p.x + Math.cos(angle) * len * 0.5 + sway2 * 5,
          p.y + Math.sin(angle) * len * 0.5,
          ex + sway * 7, ey
        );
        ctx.strokeStyle = p.color;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(ex + sway * 7, ey, 3.5, 2.2, angle, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.fill();
      }

      // 花朵
      if (p.flower) {
        const fx = p.x + sway * 9;
        const fy = p.y - p.size * 0.75 + sway2 * 3;
        ctx.beginPath();
        for (let k = 0; k < 5; k++) {
          const a = (k / 5) * Math.PI * 2 + time * 0.001;
          ctx.ellipse(fx + Math.cos(a) * 3.5, fy + Math.sin(a) * 3.5, 3, 1.8, a, 0, Math.PI * 2);
        }
        ctx.fillStyle = p.flowerColor;
        ctx.fill();
        ctx.beginPath();
        ctx.arc(fx, fy, 2.2, 0, Math.PI * 2);
        ctx.fillStyle = '#f0e0a0';
        ctx.fill();
      }
      ctx.restore();
    });
  }

  // ---------- 牌匾绘制 ----------
  function drawPlaques() {
    plaques.forEach(p => {
      ctx.save();
      // 阴影
      ctx.shadowColor = 'rgba(0, 0, 0, 0.6)';
      ctx.shadowBlur = 18;
      ctx.shadowOffsetX = 4;
      ctx.shadowOffsetY = 6;
      // 外框
      ctx.fillStyle = '#1a1008';
      ctx.beginPath();
      ctx.roundRect(p.x - 5, p.y - 5, p.w + 10, p.h + 10, 5);
      ctx.fill();
      // 底板
      ctx.shadowBlur = 10;
      ctx.shadowOffsetX = 1;
      ctx.shadowOffsetY = 2;
      ctx.fillStyle = '#3a2a1a';
      ctx.beginPath();
      ctx.roundRect(p.x, p.y, p.w, p.h, 3);
      ctx.fill();
      // 木纹
      ctx.shadowColor = 'transparent';
      ctx.shadowBlur = 0;
      ctx.shadowOffsetX = 0;
      ctx.shadowOffsetY = 0;
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.2)';
      ctx.lineWidth = 0.8;
      for (let i = 1; i < 3; i++) {
        const ly = p.y + (p.h / 3) * i + 3;
        ctx.beginPath();
        ctx.moveTo(p.x + 3, ly);
        ctx.lineTo(p.x + p.w - 3, ly);
        ctx.stroke();
      }
      // 文字
      ctx.fillStyle = '#e8d8b0';
      ctx.font = `600 ${Math.max(11, p.w * 0.18)}px 'Inter', 'Noto Serif SC', serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.shadowColor = 'rgba(0, 0, 0, 0.8)';
      ctx.shadowBlur = 8;
      ctx.shadowOffsetY = 1;
      ctx.fillText(p.label, p.x + p.w / 2, p.y + p.h / 2 + 1);
      // 边框
      ctx.shadowColor = 'transparent';
      ctx.shadowBlur = 0;
      ctx.shadowOffsetY = 0;
      ctx.strokeStyle = 'rgba(200, 180, 140, 0.4)';
      ctx.lineWidth = 1.2;
      ctx.strokeRect(p.x + 3, p.y + 3, p.w - 6, p.h - 6);
      ctx.restore();
    });
  }

  // 圆角矩形兼容
  if (!CanvasRenderingContext2D.prototype.roundRect) {
    CanvasRenderingContext2D.prototype.roundRect = function(x, y, w, h, r) {
      if (w < 2 * r) r = w / 2;
      if (h < 2 * r) r = h / 2;
      this.moveTo(x + r, y);
      this.lineTo(x + w - r, y);
      this.quadraticCurveTo(x + w, y, x + w, y + r);
      this.lineTo(x + w, y + h - r);
      this.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      this.lineTo(x + r, y + h);
      this.quadraticCurveTo(x, y + h, x, y + h - r);
      this.lineTo(x, y + r);
      this.quadraticCurveTo(x, y, x + r, y);
      this.closePath();
      return this;
    };
  }

  // ---------- 主循环 ----------
  function render() {
    time += 0.5;
    waterOffset += 0.012;

    drawSky();
    drawAllHouses();
    drawWillows();
    drawPlants();
    drawWater();
    drawSteps();
    drawBridge();
    drawPlaques();

    // 同步牌匾 DOM
    plaques.forEach((p, i) => {
      const el = plaqueElements[i];
      if (el) {
        el.style.left = p.x + 'px';
        el.style.top = p.y + 'px';
        el.style.width = p.w + 'px';
        el.style.height = p.h + 'px';
      }
    });

    requestAnimationFrame(render);
  }

  // ---------- 启动 ----------
  window.addEventListener('load', () => {
    resize();
    render();
  });
  window.addEventListener('resize', resize);
})();
</script>
</body>
</html>
